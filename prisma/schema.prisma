generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id             Int      @id @default(autoincrement())
  name           String?
  supabaseUserId String?  @unique @map("supabase_user_id") @db.Uuid
  height         Float?
  targetWeight   Float?   @map("target_weight")
  records        Record[]

  @@map("profiles")
}

model Record {
  id                    Int       @id @default(autoincrement())
  date                  DateTime  @db.Date
  weight                Float?
  steps                 Int?
  morningSystolic       Int?      @map("morning_systolic")
  morningDiastolic      Int?      @map("morning_diastolic")
  eveningSystolic       Int?      @map("evening_systolic")
  eveningDiastolic      Int?      @map("evening_diastolic")
  memo                  String?
  profileId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  profile   Profile   @relation(fields: [profileId], references: [id])

  @@unique([profileId, date])
  @@map("records")
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String

  @@map("faqs")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  content   String
  createdAt DateTime @default(now())

  @@map("contact")
}
