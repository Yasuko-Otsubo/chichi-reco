generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Records {
  id                  String          @id @default(uuid()) //主キー
  user_id             String
  date                DateTime
  weight              Float
  steps               Float
  memo                String?
  profile             profiles        @relation(fields: [user_id],  references:  [id])
}

model inquiries {
  id                  String          @id @default(uuid())
  name                String
  email               String
  content             String
}

model profiles {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  password            String
  height              Float
  target_weight       Float
  memo                String?
  records             Records[]

}

model faq {
  id                  String          @id @default(uuid())
  question            String
  answer              String
}